# ==============================================================================
# PANTAS — Environment Variables Example
# Target: Supabase & Next.js App Router
# ==============================================================================

# Public variables (dapat diakses di browser untuk Supabase Client & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Server-only secrets (HANYA untuk server-side / route handler jika diperlukan,
# JANGAN PERNAH menambahkan prefix NEXT_PUBLIC_ pada variabel ini!)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

